									"maxclass": "codebox",
									"code": "// NEBBIA - living chord engine (generated by src/build.py, edit that file instead)\n// Chord brain with voice leading, 6 analog-behaving voices, dub tape echo,\n// and a space whose sympathetic strings retune to the chord you play.\n\n// PolyBLEP residual (band-limited edges)\nblep(t, dt) {\n\tr = 0;\n\tx = 0;\n\tif (t < dt) {\n\t\tx = t / dt;\n\t\tr = x + x - x * x - 1;\n\t}\n\telse if (t > 1 - dt) {\n\t\tx = (t - 1) / dt;\n\t\tr = x * x + x + x + 1;\n\t}\n\treturn r;\n}\n\n// triangle -1..1 from a phase\nftri(x) {\n\tfr = x - floor(x);\n\treturn 1 - 4 * abs(fr - 0.5);\n}\n\n// transparent below 0.8, smooth ceiling at 1.0\nsclip(x) {\n\tax = abs(x);\n\ty = x;\n\tif (ax > 0.8) {\n\t\ty = ((x > 0) ? 1 : -1) * (0.8 + 0.2 * tanh((ax - 0.8) * 5));\n\t}\n\treturn y;\n}\n\npick6(i, v0, v1, v2, v3, v4, v5) {\n\treturn ((i < 0.5) ? v0 : ((i < 1.5) ? v1 : ((i < 2.5) ? v2 : ((i < 3.5) ? v3 : ((i < 4.5) ? v4 : v5)))));\n}\n\nchordsize(c) {\n\treturn ((c < 0.5) ? 4 : ((c < 1.5) ? 5 : ((c < 2.5) ? 6 : ((c < 3.5) ? 4 : ((c < 4.5) ? 5 : ((c < 5.5) ? 5 : ((c < 6.5) ? 4 : ((c < 7.5) ? 3 : ((c < 8.5) ? 4 : ((c < 9.5) ? 3 : ((c < 10.5) ? 3 : ((c < 11.5) ? 4 : ((c < 12.5) ? 5 : ((c < 13.5) ? 5 : ((c < 14.5) ? 4 : 4)))))))))))))));\n}\n\nchordiv(c, k) {\n\tr = 0;\n\tif (c < 0.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 12 : 15)))));\n\t}\n\telse if (c < 1.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 14 : 12)))));\n\t}\n\telse if (c < 2.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 14 : 17)))));\n\t}\n\telse if (c < 3.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 7 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 12 : 19)))));\n\t}\n\telse if (c < 4.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 7 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 17 : 12)))));\n\t}\n\telse if (c < 5.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 5 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 19 : 12)))));\n\t}\n\telse if (c < 6.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 5 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 12 : 17)))));\n\t}\n\telse if (c < 7.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 2 : ((k < 2.5) ? 7 : ((k < 3.5) ? 12 : ((k < 4.5) ? 14 : 19)))));\n\t}\n\telse if (c < 8.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 5 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 12 : 17)))));\n\t}\n\telse if (c < 9.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 12 : ((k < 4.5) ? 15 : 19)))));\n\t}\n\telse if (c < 10.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 12 : ((k < 4.5) ? 16 : 19)))));\n\t}\n\telse if (c < 11.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 11 : ((k < 4.5) ? 12 : 16)))));\n\t}\n\telse if (c < 12.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 11 : ((k < 4.5) ? 14 : 12)))));\n\t}\n\telse if (c < 13.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 14 : 12)))));\n\t}\n\telse if (c < 14.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 6 : ((k < 3.5) ? 10 : ((k < 4.5) ? 12 : 15)))));\n\t}\n\telse {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 7 : ((k < 2.5) ? 12 : ((k < 3.5) ? 19 : ((k < 4.5) ? 12 : 19)))));\n\t}\n\treturn r;\n}\n\nscalenote(s, i) {\n\tr = 0;\n\tif (s < 1.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 10))))));\n\t}\n\telse if (s < 2.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 10))))));\n\t}\n\telse if (s < 3.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 10))))));\n\t}\n\telse if (s < 4.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 11))))));\n\t}\n\telse if (s < 5.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 10))))));\n\t}\n\telse if (s < 6.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 6 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 11))))));\n\t}\n\telse {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 11))))));\n\t}\n\treturn r;\n}\n\nsdeg(s, idx) {\n\to = floor(idx / 7);\n\treturn scalenote(s, idx - 7 * o) + 12 * o;\n}\n\nedivs(i) {\n\treturn ((i < 0.5) ? 0.25 : ((i < 1.5) ? 0.3333333 : ((i < 2.5) ? 0.5 : ((i < 3.5) ? 0.75 : ((i < 4.5) ? 0.6666667 : ((i < 5.5) ? 1 : ((i < 6.5) ? 1.5 : 2)))))));\n}\n\nParam p_harm(0);\nParam p_chord(1);\nParam p_key(9);\nParam p_voicing(6);\nParam p_notes(5);\nParam p_oct(0);\nParam p_strum(6);\nParam p_glide(0);\nParam p_human(30);\nParam p_bendr(2);\nParam p_shape(25);\nParam p_pw(42);\nParam p_pwm(25);\nParam p_pwmrate(0.6);\nParam p_osc2(70);\nParam p_detune(7);\nParam p_sub(0);\nParam p_air(10);\nParam p_drift(35);\nParam p_driftrate(0.5);\nParam p_age(40);\nParam p_sag(35);\nParam p_cutoff(600);\nParam p_reso(30);\nParam p_drive(30);\nParam p_slope(0);\nParam p_fenv(45);\nParam p_ktrk(35);\nParam p_mwcut(60);\nParam p_lforate(0.15);\nParam p_lfoamt(15);\nParam p_lfowave(0);\nParam p_fa(2);\nParam p_fd(280);\nParam p_fs(0);\nParam p_fr(350);\nParam p_aa(3);\nParam p_ad(450);\nParam p_as(0);\nParam p_ar(350);\nParam p_velsens(40);\nParam p_velfilt(50);\nParam p_etime(3);\nParam p_efb(62);\nParam p_emix(45);\nParam p_elocut(90);\nParam p_ehicut(2600);\nParam p_edrive(35);\nParam p_wow(30);\nParam p_flutter(20);\nParam p_espread(75);\nParam p_rdecay(4500);\nParam p_rsize(100);\nParam p_rmix(32);\nParam p_tune(50);\nParam p_sdecay(3500);\nParam p_damp(45);\nParam p_rlocut(150);\nParam p_diff(80);\nParam p_rmod(35);\nParam p_chorus(30);\nParam p_crate(0.5);\nParam p_cdepth(50);\n