// ================= setup =================
sr = samplerate;
isr = 1 / sr;
sm = 1 - exp(-1 / (0.015 * sr));
s_cut = h_s_cut + ((log(clamp(p_cutoff, 20, 20000)) * 1.442695) - h_s_cut) * sm;
s_res = h_s_res + ((clamp(p_reso, 0, 100) * 0.01) - h_s_res) * sm;
s_drv = h_s_drv + ((clamp(p_drive, 0, 100) * 0.01) - h_s_drv) * sm;
s_efb = h_s_efb + ((clamp(p_efb, 0, 110) * 0.01) - h_s_efb) * sm;
s_emix = h_s_emix + ((clamp(p_emix, 0, 100) * 0.01 * (p_echoon > 0.5)) - h_s_emix) * sm;
s_rmix = h_s_rmix + ((clamp(p_rmix, 0, 100) * 0.01 * (p_spaceon > 0.5)) - h_s_rmix) * sm;
s_eon = h_s_eon + ((p_echoon > 0.5) - h_s_eon) * sm;
s_son = h_s_son + ((p_spaceon > 0.5) - h_s_son) * sm;
s_flt = h_s_flt + ((p_filton > 0.5) - h_s_flt) * sm;
s_tune = h_s_tune + ((clamp(p_tune, 0, 100) * 0.01) - h_s_tune) * sm;
s_chor = h_s_chor + ((clamp(p_chorus, 0, 100) * 0.01 * (p_choron > 0.5)) - h_s_chor) * sm;
s_wid = h_s_wid + ((clamp(p_width, 0, 100) * 0.01) - h_s_wid) * sm;
s_vol = h_s_vol + ((exp(clamp(p_vol, -70, 6) * 0.1151293)) - h_s_vol) * sm;
s_mw = h_s_mw + ((clamp(p_modw, 0, 127) / 127 * clamp(p_mwcut, 0, 100) * 0.05) - h_s_mw) * sm;
s_size = h_s_size + ((clamp(p_rsize, 50, 150) * 0.01) - h_s_size) * sm;
shp = clamp(p_shape, 0, 100) * 0.01;
pwb = clamp(p_pw, 5, 50) * 0.01;
pwmd = clamp(p_pwm, 0, 100) * 0.004;
det = clamp(p_detune, 0, 50);
lv2 = clamp(p_osc2, 0, 100) * 0.01;
hum = clamp(p_human, 0, 100) * 0.01;
vfs = clamp(p_velfilt, 0, 100) * 0.01;
cfr = 1 - exp(-4 / (max(p_fr, 1) * 0.001 * sr));
detu = exp(det * 0.000577623);
detd = 1 / detu;
subl = clamp(p_sub, 0, 100) * 0.01;
air = clamp(p_air, 0, 100) * 0.008;
anon = p_analogon > 0.5;
drift = clamp(p_drift, 0, 100) * 0.01 * anon;
age = clamp(p_age, 0, 100) * 0.01 * anon;
fenv = clamp(p_fenv, -100, 100) * 0.06;
ktrk = clamp(p_ktrk, 0, 100) * 0.01 * 0.0833333;
lfoamt = clamp(p_lfoamt, 0, 100) * 0.02;
vsens = clamp(p_velsens, 0, 100) * 0.01;
sagk = clamp(p_sag, 0, 100) * 0.01 * anon;
fsus = clamp(p_fs, 0, 100) * 0.01;
asus = clamp(p_as, 0, 100) * 0.01;
cfa = 1 - exp(-1.466 / (max(p_fa, 0.3) * 0.001 * sr));
cfd = 1 - exp(-4 / (max(p_fd, 1) * 0.001 * sr));
caa = 1 - exp(-1.466 / (max(p_aa, 0.3) * 0.001 * sr));
cad = 1 - exp(-4 / (max(p_ad, 1) * 0.001 * sr));
car = 1 - exp(-4 / (max(p_ar, 1) * 0.001 * sr));
glc = 1 - exp(-3 / (max(p_glide, 0.05) * 0.001 * sr));
sgl = 1 - exp(-3 / (max(p_glide, 90) * 0.001 * sr));
bendst = (clamp(p_bend, 0, 127) - 64) * 0.015625 * clamp(p_bendr, 0, 24);
drm = clamp(p_driftrate, 0.01, 10) * 2;
dsm = 1 - exp(-6.2831853 * clamp(p_driftrate, 0.01, 10) / sr);
gin = 0.42 * (1 + s_drv * 4);
strum_s = abs(clamp(p_strum, -1000, 1000)) * 0.001 * sr;
sdn = p_strum < 0;

// ================= modulators =================
lfr = clamp(p_lforate, 0.005, 40);
lph = h_lph + lfr * isr;
lsh = h_lsh;
if (lph >= 1) {
