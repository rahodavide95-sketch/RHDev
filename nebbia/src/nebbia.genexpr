// NEBBIA - living chord engine (generated by src/build.py, edit that file instead)
// Chord brain with voice leading, 6 analog-behaving voices, dub tape echo,
// and a space whose sympathetic strings retune to the chord you play.

// PolyBLEP residual (band-limited edges)
blep(t, dt) {
	r = 0;
	x = 0;
	if (t < dt) {
		x = t / dt;
		r = x + x - x * x - 1;
	}
	else if (t > 1 - dt) {
		x = (t - 1) / dt;
		r = x * x + x + x + 1;
	}
	return r;
}

// triangle -1..1 from a phase
ftri(x) {
	fr = x - floor(x);
	return 1 - 4 * abs(fr - 0.5);
}

// transparent below 0.8, smooth ceiling at 1.0
sclip(x) {
	ax = abs(x);
	y = x;
	if (ax > 0.8) {
		y = ((x > 0) ? 1 : -1) * (0.8 + 0.2 * tanh((ax - 0.8) * 5));
	}
	return y;
}

pick6(i, v0, v1, v2, v3, v4, v5) {
	return ((i < 0.5) ? v0 : ((i < 1.5) ? v1 : ((i < 2.5) ? v2 : ((i < 3.5) ? v3 : ((i < 4.5) ? v4 : v5)))));
}

chordsize(c) {
	return ((c < 0.5) ? 4 : ((c < 1.5) ? 5 : ((c < 2.5) ? 6 : ((c < 3.5) ? 4 : ((c < 4.5) ? 5 : ((c < 5.5) ? 5 : ((c < 6.5) ? 4 : ((c < 7.5) ? 3 : ((c < 8.5) ? 4 : ((c < 9.5) ? 3 : ((c < 10.5) ? 3 : ((c < 11.5) ? 4 : ((c < 12.5) ? 5 : ((c < 13.5) ? 5 : ((c < 14.5) ? 4 : 4)))))))))))))));
}

chordiv(c, k) {
