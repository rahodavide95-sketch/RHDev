cbb = 1 - exp(-6.2831853 * 7000 * isr);
cbl = h_cbl + (cwl - h_cbl) * cbb;
cbr = h_cbr + (cwr - h_cbr) * cbb;
xL = vL * (1 - 0.3 * s_chor) + cbl * s_chor * 0.8;
xR = vR * (1 - 0.3 * s_chor) + cbr * s_chor * 0.8;

// ================= dub tape echo =================
bpm = clamp(p_bpm, 20, 999);
etg = clamp(60 / bpm * edivs(clamp(floor(p_etime + 0.5), 0, 7)) * sr, 64, 380000);
ets = h_ets + (etg - h_ets) * (1 - exp(-3.3 / sr));
wph = h_wph + 0.37 * isr;
wph = wph - floor(wph);
fph = h_fph + 5.3 * isr;
fph = fph - floor(fph);
wamt = clamp(p_wow, 0, 100) * 0.01;
famt = clamp(p_flutter, 0, 100) * 0.01;
wm = (wamt * (sin(6.2831853 * wph) * 0.0019 + gdv * 0.0012) + famt * sin(6.2831853 * fph) * 0.0003) * sr;
pp = clamp(p_espread, 0, 100) * 0.01;
eol = edL.read(clamp(ets + wm, 2, 390000));
eor = edR.read(clamp(ets - wm * 0.7 + pp * 0.004 * sr, 2, 390000));
ehc = 1 - exp(-6.2831853 * clamp(p_elocut, 10, 2000) * isr);
elc = 1 - exp(-6.2831853 * clamp(p_ehicut, 200, 20000) * isr);
ehl = h_ehl + (eol - h_ehl) * ehc;
el1 = h_el1 + (eol - ehl - h_el1) * elc;
el2 = h_el2 + (el1 - h_el2) * elc;
ehr = h_ehr + (eor - h_ehr) * ehc;
er1 = h_er1 + (eor - ehr - h_er1) * elc;
er2 = h_er2 + (er1 - h_er2) * elc;
edg = 0.3 + clamp(p_edrive, 0, 100) * 0.03;
etl = tanh(el2 * edg) / edg;
etr = tanh(er2 * edg) / edg;
ein = (xL + xR) * 0.5;
edL.write((ein + s_efb * (etl * (1 - pp) + etr * pp)) * s_eon);
edR.write((ein * (1 - pp) + s_efb * (etr * (1 - pp) + etl * pp)) * s_eon);

// ================= space: sympathetic strings tuned to the chord =================
sil = xL + el2 * s_emix;
sir = xR + er2 * s_emix;
shc = 1 - exp(-6.2831853 * clamp(p_rlocut, 10, 2000) * isr);
shl = h_shl + (sil - h_shl) * shc;
shr = h_shr + (sir - h_shr) * shc;
hil = sil - shl;
hir = sir - shr;
sdamp = clamp(p_damp, 0, 100) * 0.01;
sa = 0.85 - 0.55 * sdamp;
stau = (1 - sa) / sa;
rt = clamp(p_rdecay, 100, 30000) * 0.001;
srt = clamp(p_sdecay, 100, 30000) * 0.001;
sex = (hil + hir) * 0.5 * s_tune * s_son;
stL = 0;
stR = 0;
sf_0 = 440 * exp((h_sp_0 - 69) * 0.057762265);
sP_0 = clamp(sr / sf_0, 6, 8000);
sy_0 = sd0.read(max(sP_0 - stau, 2));
sl_0 = h_sl_0 + (sy_0 - h_sl_0) * sa;
sg_0 = exp(-6.9078 * sP_0 / (srt * sr));
sd0.write(tanh(sex * (1 - sg_0) * 100 + sl_0 * sg_0));
stL = stL + sl_0;
sf_1 = 440 * exp((h_sp_1 - 69) * 0.057762265);
sP_1 = clamp(sr / sf_1, 6, 8000);
sy_1 = sd1.read(max(sP_1 - stau, 2));
sl_1 = h_sl_1 + (sy_1 - h_sl_1) * sa;
sg_1 = exp(-6.9078 * sP_1 / (srt * sr));
sd1.write(tanh(sex * (1 - sg_1) * 100 + sl_1 * sg_1));
stR = stR + sl_1;
sf_2 = 440 * exp((h_sp_2 - 69) * 0.057762265);
sP_2 = clamp(sr / sf_2, 6, 8000);
sy_2 = sd2.read(max(sP_2 - stau, 2));
sl_2 = h_sl_2 + (sy_2 - h_sl_2) * sa;
sg_2 = exp(-6.9078 * sP_2 / (srt * sr));
sd2.write(tanh(sex * (1 - sg_2) * 100 + sl_2 * sg_2));
stL = stL + sl_2;
sf_3 = 440 * exp((h_sp_3 - 69) * 0.057762265);
sP_3 = clamp(sr / sf_3, 6, 8000);
sy_3 = sd3.read(max(sP_3 - stau, 2));
sl_3 = h_sl_3 + (sy_3 - h_sl_3) * sa;
sg_3 = exp(-6.9078 * sP_3 / (srt * sr));
sd3.write(tanh(sex * (1 - sg_3) * 100 + sl_3 * sg_3));
stR = stR + sl_3;
sf_4 = 440 * exp((h_sp_4 - 69) * 0.057762265);
sP_4 = clamp(sr / sf_4, 6, 8000);
sy_4 = sd4.read(max(sP_4 - stau, 2));
sl_4 = h_sl_4 + (sy_4 - h_sl_4) * sa;
sg_4 = exp(-6.9078 * sP_4 / (srt * sr));
sd4.write(tanh(sex * (1 - sg_4) * 100 + sl_4 * sg_4));
stL = stL + sl_4;
sf_5 = 440 * exp((h_sp_5 - 69) * 0.057762265);
sP_5 = clamp(sr / sf_5, 6, 8000);
sy_5 = sd5.read(max(sP_5 - stau, 2));
sl_5 = h_sl_5 + (sy_5 - h_sl_5) * sa;
sg_5 = exp(-6.9078 * sP_5 / (srt * sr));
sd5.write(tanh(sex * (1 - sg_5) * 100 + sl_5 * sg_5));
stR = stR + sl_5;

// ================= space: 8-line feedback delay network =================
apg = clamp(p_diff, 0, 100) * 0.0075;
rinl = (hil * (1 - 0.7 * s_tune) + stL * s_tune * 0.3) * s_son;
rinr = (hir * (1 - 0.7 * s_tune) + stR * s_tune * 0.3) * s_son;
apla = apl1.read(4.3 * 0.001 * sr);
aplw = rinl + apg * apla;
apl1.write(aplw);
aply = apla - apg * aplw;
aplb = apl2.read(6.9 * 0.001 * sr);
aplv = aply + apg * aplb;
apl2.write(aplv);
difl = aplb - apg * aplv;
apra = apr1.read(5.1 * 0.001 * sr);
aprw = rinr + apg * apra;
apr1.write(aprw);
apry = apra - apg * aprw;
aprb = apr2.read(7.7 * 0.001 * sr);
aprv = apry + apg * aprb;
apr2.write(aprv);
difr = aprb - apg * aprv;
mph = h_mph + 0.29 * isr;
mph = mph - floor(mph);
rmod = sin(6.2831853 * mph) * clamp(p_rmod, 0, 100) * 0.00001 * sr;
rdc = 1 - exp(-6.2831853 * 12000 * exp(sdamp * (-2.3)) * isr);
fl0 = 29.3 * s_size * 0.001 * sr;
fr0 = fd0.read(fl0);
dl0 = h_dl0 + (fr0 - h_dl0) * rdc;
z0 = dl0 * exp(-6.9078 * fl0 / (rt * sr));
fl1 = 36.7 * s_size * 0.001 * sr + rmod;
fr1 = fd1.read(fl1);
dl1 = h_dl1 + (fr1 - h_dl1) * rdc;
z1 = dl1 * exp(-6.9078 * fl1 / (rt * sr));
fl2 = 41.3 * s_size * 0.001 * sr;
fr2 = fd2.read(fl2);
dl2 = h_dl2 + (fr2 - h_dl2) * rdc;
z2 = dl2 * exp(-6.9078 * fl2 / (rt * sr));
fl3 = 47.9 * s_size * 0.001 * sr;
fr3 = fd3.read(fl3);
dl3 = h_dl3 + (fr3 - h_dl3) * rdc;
z3 = dl3 * exp(-6.9078 * fl3 / (rt * sr));
fl4 = 53.7 * s_size * 0.001 * sr;
fr4 = fd4.read(fl4);
dl4 = h_dl4 + (fr4 - h_dl4) * rdc;
z4 = dl4 * exp(-6.9078 * fl4 / (rt * sr));
fl5 = 61.1 * s_size * 0.001 * sr;
fr5 = fd5.read(fl5);
dl5 = h_dl5 + (fr5 - h_dl5) * rdc;
z5 = dl5 * exp(-6.9078 * fl5 / (rt * sr));
fl6 = 67.9 * s_size * 0.001 * sr - rmod;
fr6 = fd6.read(fl6);
dl6 = h_dl6 + (fr6 - h_dl6) * rdc;
z6 = dl6 * exp(-6.9078 * fl6 / (rt * sr));
fl7 = 76.3 * s_size * 0.001 * sr;
fr7 = fd7.read(fl7);
dl7 = h_dl7 + (fr7 - h_dl7) * rdc;
z7 = dl7 * exp(-6.9078 * fl7 / (rt * sr));
a0h = z0 + z1;
a1h = z0 - z1;
a2h = z2 + z3;
a3h = z2 - z3;
a4h = z4 + z5;
a5h = z4 - z5;
a6h = z6 + z7;
a7h = z6 - z7;
b0h = a0h + a2h;
b2h = a0h - a2h;
b1h = a1h + a3h;
b3h = a1h - a3h;
b4h = a4h + a6h;
b6h = a4h - a6h;
b5h = a5h + a7h;
b7h = a5h - a7h;
fd0.write((b0h + b4h) * 0.3535534 + difl * 0.5);
fd4.write((b0h - b4h) * 0.3535534 + difl * 0.5);
fd1.write((b1h + b5h) * 0.3535534 + difr * 0.5);
fd5.write((b1h - b5h) * 0.3535534 + 0 - difr * 0.5);
fd2.write((b2h + b6h) * 0.3535534 + 0 - difl * 0.5);
fd6.write((b2h - b6h) * 0.3535534 + 0 - difl * 0.5);
fd3.write((b3h + b7h) * 0.3535534 + 0 - difr * 0.5);
fd7.write((b3h - b7h) * 0.3535534 + difr * 0.5);
rvL = (dl0 - dl2 + dl4 + dl6) * 0.5;
rvR = (dl1 + dl3 - dl5 + dl7) * 0.5;

// ================= output =================
ml = xL + el2 * s_emix + (rvL + stL * s_tune * 0.25) * s_rmix;
mr = xR + er2 * s_emix + (rvR + stR * s_tune * 0.25) * s_rmix;
dyl = ml - h_dxl + 0.9993 * h_dyl;
dyr = mr - h_dxr + 0.9993 * h_dyr;
out1 = sclip(dyl * s_vol);
out2 = sclip(dyr * s_vol);
out3 = (0 < nn) ? q0 : -1;
out4 = (1 < nn) ? q1 : -1;
out5 = (2 < nn) ? q2 : -1;
out6 = (3 < nn) ? q3 : -1;
out7 = (4 < nn) ? q4 : -1;
out8 = (5 < nn) ? q5 : -1;
out9 = (srun > 0) ? stp : -1;

// ================= state =================
h_s_cut = s_cut;
h_s_res = s_res;
h_s_drv = s_drv;
h_s_efb = s_efb;
h_s_emix = s_emix;
h_s_rmix = s_rmix;
h_s_eon = s_eon;
h_s_son = s_son;
h_s_flt = s_flt;
h_s_tune = s_tune;
h_s_chor = s_chor;
h_s_wid = s_wid;
h_s_vol = s_vol;
h_s_mw = s_mw;
h_s_size = s_size;
h_lph = lph;
h_pph = pph;
h_lsh = lsh;
h_lsm = lsm;
h_gdp = gdp;
h_gdt = gdt;
h_gdv = gdv;
