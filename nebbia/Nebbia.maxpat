_5 + (sy_5 - h_sl_5) * sa;\nsg_5 = exp(-6.9078 * sP_5 / (srt * sr));\nsd5.write(tanh(sex * (1 - sg_5) * 100 + sl_5 * sg_5));\nstR = stR + sl_5;\n\n// ================= space: 8-line feedback delay network =================\napg = clamp(p_diff, 0, 100) * 0.0075;\nrinl = hil * (1 - 0.7 * s_tune) + stL * s_tune * 0.3;\nrinr = hir * (1 - 0.7 * s_tune) + stR * s_tune * 0.3;\napla = apl1.read(4.3 * 0.001 * sr);\naplw = rinl + apg * apla;\napl1.write(aplw);\naply = apla - apg * aplw;\naplb = apl2.read(6.9 * 0.001 * sr);\naplv = aply + apg * aplb;\napl2.write(aplv);\ndifl = aplb - apg * aplv;\napra = apr1.read(5.1 * 0.001 * sr);\naprw = rinr + apg * apra;\napr1.write(aprw);\napry = apra - apg * aprw;\naprb = apr2.read(7.7 * 0.001 * sr);\naprv = apry + apg * aprb;\napr2.write(aprv);\ndifr = aprb - apg * aprv;\nmph = h_mph + 0.29 * isr;\nmph = mph - floor(mph);\nrmod = sin(6.2831853 * mph) * clamp(p_rmod, 0, 100) * 0.00001 * sr;\nrdc = 1 - exp(-6.2831853 * 12000 * exp(sdamp * (-2.3)) * isr);\nfl0 = 29.3 * s_size * 0.001 * sr;\nfr0 = fd0.read(fl0);\ndl0 = h_dl0 + (fr0 - h_dl0) * rdc;\nz0 = dl0 * exp(-6.9078 * fl0 / (rt * sr));\nfl1 = 36.7 * s_size * 0.001 * sr + rmod;\nfr1 = fd1.read(fl1);\ndl1 = h_dl1 + (fr1 - h_dl1) * rdc;\nz1 = dl1 * exp(-6.9078 * fl1 / (rt * sr));\nfl2 = 41.3 * s_size * 0.001 * sr;\nfr2 = fd2.read(fl2);\ndl2 = h_dl2 + (fr2 - h_dl2) * rdc;\nz2 = dl2 * exp(-6.9078 * fl2 / (rt * sr));\nfl3 = 47.9 * s_size * 0.001 * sr;\nfr3 = fd3.read(fl3);\ndl3 = h_dl3 + (fr3 - h_dl3) * rdc;\nz3 = dl3 * exp(-6.9078 * fl3 / (rt * sr));\nfl4 = 53.7 * s_size * 0.001 * sr;\nfr4 = fd4.read(fl4);\ndl4 = h_dl4 + (fr4 - h_dl4) * rdc;\nz4 = dl4 * exp(-6.9078 * fl4 / (rt * sr));\nfl5 = 61.1 * s_size * 0.001 * sr;\nfr5 = fd5.read(fl5);\ndl5 = h_dl5 + (fr5 - h_dl5) * rdc;\nz5 = dl5 * exp(-6.9078 * fl5 / (rt * sr));\nfl6 = 67.9 * s_size * 0.001 * sr - rmod;\nfr6 = fd6.read(fl6);\ndl6 = h_dl6 + (fr6 - h_dl6) * rdc;\nz6 = dl6 * exp(-6.9078 * fl6 / (rt * sr));\nfl7 = 76.3 * s_size * 0.001 * sr;\nfr7 = fd7.read(fl7);\ndl7 = h_dl7 + (fr7 - h_dl7) * rdc;\nz7 = dl7 * exp(-6.9078 * fl7 / (rt * sr));\na0h = z0 + z1;\na1h = z0 - z1;\na2h = z2 + z3;\na3h = z2 - z3;\na4h = z4 + z5;\na5h = z4 - z5;\na6h = z6 + z7;\na7h = z6 - z7;\nb0h = a0h + a2h;\nb2h = a0h - a2h;\nb1h = a1h + a3h;\nb3h = a1h - a3h;\nb4h = a4h + a6h;\nb6h = a4h - a6h;\nb5h = a5h + a7h;\nb7h = a5h - a7h;\nfd0.write((b0h + b4h) * 0.3535534 + difl * 0.5);\nfd4.write((b0h - b4h) * 0.3535534 + difl * 0.5);\nfd1.write((b1h + b5h) * 0.3535534 + difr * 0.5);\nfd5.write((b1h - b5h) * 0.3535534 + 0 - difr * 0.5);\nfd2.write((b2h + b6h) * 0.3535534 + 0 - difl * 0.5);\nfd6.write((b2h - b6h) * 0.3535534 + 0 - difl * 0.5);\nfd3.write((b3h + b7h) * 0.3535534 + 0 - difr * 0.5);\nfd7.write((b3h - b7h) * 0.3535534 + difr * 0.5);\nrvL = (dl0 - dl2 + dl4 + dl6) * 0.5;\nrvR = (dl1 + dl3 - dl5 + dl7) * 0.5;\n\n// ================= output =================\nml = xL + el2 * s_emix + (rvL + stL * s_tune * 0.25) * s_rmix;\nmr = xR + er2 * s_emix + (rvR + stR * s_tune * 0.25) * s_rmix;\ndyl = ml - h_dxl + 0.9993 * h_dyl;\ndyr = mr - h_dxr + 0.9993 * h_dyr;\nout1 = sclip(dyl * s_vol);\nout2 = sclip(dyr * s_vol);\n\n// ================= state =================\nh_s_cut = s_cut;\nh_s_res = s_res;\nh_s_drv = s_drv;\nh_s_efb = s_efb;\nh_s_emix = s_emix;\nh_s_rmix = s_rmix;\nh_s_tune = s_tune;\nh_s_chor = s_chor;\nh_s_wid = s_wid;\nh_s_vol = s_vol;\nh_s_mw = s_mw;\nh_s_size = s_size;\nh_lph = lph;\nh_pph = pph;\nh_lsh = lsh;\nh_lsm = lsm;\nh_gdp = gdp;\nh_gdt = gdt;\nh_gdv = gdv;\nh_trig = p_trig;\nh_st = st;\nh_harm = p_harm;\nh_chord = p_chord;\nh_key = p_key;\nh_voic = p_voicing;\nh_notes = p_notes;\nh_oct = p_oct;\nh_nn = nn;\nh_q0 = q0;\nh_q1 = q1;\nh_q2 = q2;\nh_q3 = q3;\nh_q4 = q4;\nh_q5 = q5;\nh_rmean = rmean;\nh_rtop = rtop;\nh_rbot = rbot;\nh_rvalid = rvalid;\nh_cmean = cmean;\nh_ctop = ctop;\nh_cbot = cbot;\nh_cvalid = cvalid;\nh_p3 = p3;\nh_pd_0 = pd_0;\nh_hz_0 = hz_0;\nh_tp_0 = tp_0;\nh_pv_0 = pv_0;\nh_vl_0 = vl_