									"maxclass": "codebox",
									"code": "// DUB MACHINE - living chord engine (generated by src/build.py, edit that file instead)\n// Chord brain with voice leading, 6 analog-behaving voices, dub tape echo,\n// and a space whose sympathetic strings retune to the chord you play.\n\n// PolyBLEP residual (band-limited edges)\nblep(t, dt) {\n\tr = 0;\n\tx = 0;\n\tif (t < dt) {\n\t\tx = t / dt;\n\t\tr = x + x - x * x - 1;\n\t}\n\telse if (t > 1 - dt) {\n\t\tx = (t - 1) / dt;\n\t\tr = x * x + x + x + 1;\n\t}\n\treturn r;\n}\n\n// triangle -1..1 from a phase\nftri(x) {\n\tfr = x - floor(x);\n\treturn 1 - 4 * abs(fr - 0.5);\n}\n\n// transparent below 0.8, smooth ceiling at 1.0\nsclip(x) {\n\tax = abs(x);\n\ty = x;\n\tif (ax > 0.8) {\n\t\ty = ((x > 0) ? 1 : -1) * (0.8 + 0.2 * tanh((ax - 0.8) * 5));\n\t}\n\treturn y;\n}\n\npick6(i, v0, v1, v2, v3, v4, v5) {\n\treturn ((i < 0.5) ? v0 : ((i < 1.5) ? v1 : ((i < 2.5) ? v2 : ((i < 3.5) ? v3 : ((i < 4.5) ? v4 : v5)))));\n}\n\nchordsize(c) {\n\treturn ((c < 0.5) ? 4 : ((c < 1.5) ? 5 : ((c < 2.5) ? 6 : ((c < 3.5) ? 4 : ((c < 4.5) ? 5 : ((c < 5.5) ? 5 : ((c < 6.5) ? 4 : ((c < 7.5) ? 3 : ((c < 8.5) ? 4 : ((c < 9.5) ? 3 : ((c < 10.5) ? 3 : ((c < 11.5) ? 4 : ((c < 12.5) ? 5 : ((c < 13.5) ? 5 : ((c < 14.5) ? 4 : 4)))))))))))))));\n}\n\nchordiv(c, k) {\n\tr = 0;\n\tif (c < 0.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 12 : 15)))));\n\t}\n\telse if (c < 1.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 14 : 12)))));\n\t}\n\telse if (c < 2.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 14 : 17)))));\n\t}\n\telse if (c < 3.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 7 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 12 : 19)))));\n\t}\n\telse if (c < 4.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 7 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 17 : 12)))));\n\t}\n\telse if (c < 5.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 5 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 19 : 12)))));\n\t}\n\telse if (c < 6.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 5 : ((k < 2.5) ? 10 : ((k < 3.5) ? 15 : ((k < 4.5) ? 12 : 17)))));\n\t}\n\telse if (c < 7.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 2 : ((k < 2.5) ? 7 : ((k < 3.5) ? 12 : ((k < 4.5) ? 14 : 19)))));\n\t}\n\telse if (c < 8.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 5 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 12 : 17)))));\n\t}\n\telse if (c < 9.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 7 : ((k < 3.5) ? 12 : ((k < 4.5) ? 15 : 19)))));\n\t}\n\telse if (c < 10.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 12 : ((k < 4.5) ? 16 : 19)))));\n\t}\n\telse if (c < 11.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 11 : ((k < 4.5) ? 12 : 16)))));\n\t}\n\telse if (c < 12.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 11 : ((k < 4.5) ? 14 : 12)))));\n\t}\n\telse if (c < 13.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 4 : ((k < 2.5) ? 7 : ((k < 3.5) ? 10 : ((k < 4.5) ? 14 : 12)))));\n\t}\n\telse if (c < 14.5) {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 3 : ((k < 2.5) ? 6 : ((k < 3.5) ? 10 : ((k < 4.5) ? 12 : 15)))));\n\t}\n\telse {\n\t\tr = ((k < 0.5) ? 0 : ((k < 1.5) ? 7 : ((k < 2.5) ? 14 : ((k < 3.5) ? 21 : ((k < 4.5) ? 12 : 19)))));\n\t}\n\treturn r;\n}\n\nscalenote(s, i) {\n\tr = 0;\n\tif (s < 1.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 10))))));\n\t}\n\telse if (s < 2.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 10))))));\n\t}\n\telse if (s < 3.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 10))))));\n\t}\n\telse if (s < 4.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 11))))));\n\t}\n\telse if (s < 5.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 10))))));\n\t}\n\telse if (s < 6.5) {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 6 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 11))))));\n\t}\n\telse {\n\t\tr = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 11))))));\n\t}\n\treturn r;\n}\n\nsdeg(s, idx) {\n\to = floor(idx / 7);\n\treturn scalenote(s, idx - 7 * o) + 12 * o;\n}\n\nedivs(i) {\n\treturn ((i < 0.5) ? 0.25 : ((i < 1.5) ? 0.3333333 : ((i < 2.5) ? 0.5 : ((i < 3.5) ? 0.75 : ((i < 4.5) ? 0.6666667 : ((i < 5.5) ? 1 : ((i < 6.5) ? 1.5 : 2)))))));\n}\n\n// chord families used by the dice\nfammin(i) {\n\treturn ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 2 : ((i < 3.5) ? 3 : ((i < 4.5) ? 4 : ((i < 5.5) ? 5 : ((i < 6.5) ? 6 : ((i < 7.5) ? 7 : ((i < 8.5) ? 8 : ((i < 9.5) ? 9 : 15))))))))));\n}\n\nfammaj(i) {\n\treturn ((i < 0.5) ? 10 : ((i < 1.5) ? 11 : ((i < 2.5) ? 12 : ((i < 3.5) ? 13 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : ((i < 6.5) ? 6 : 15)))))));\n}\n\nfamdark(i) {\n\treturn ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 2 : ((i < 3.5) ? 3 : ((i < 4.5) ? 4 : ((i < 5.5) ? 5 : ((i < 6.5) ? 6 : ((i < 7.5) ? 7 : ((i < 8.5) ? 8 : ((i < 9.5) ? 9 : ((i < 10.5) ? 14 : 15)))))))))));\n}\n\nParam p_seqon(0);\nParam p_seqmode(0);\nParam p_seqrate(1);\nParam p_seqlen(8);\nParam p_sgate(50);\nParam p_swing(0);\nParam p_schance(100);\nParam p_son1(0);\nParam p_snote1(0);\nParam p_sacc1(0);\nParam p_son2(1);\nParam p_snote2(0);\nParam p_sacc2(0);\nParam p_son3(0);\nParam p_snote3(0);\nParam p_sacc3(0);\nParam p_son4(1);\nParam p_snote4(0);\nParam p_sacc4(0);\nParam p_son5(0);\nParam p_snote5(0);\nParam p_sacc5(0);\nParam p_son6(1);\nParam p_snote6(0);\nParam p_sacc6(0);\nParam p_son7(0);\nParam p_snote7(0);\nParam p_sacc7(0);\nParam p_son8(1);\nParam p_snote8(0);\nParam p