	}
	return r;
}

scalenote(s, i) {
	r = 0;
	if (s < 1.5) {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 10))))));
	}
	else if (s < 2.5) {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 10))))));
	}
	else if (s < 3.5) {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 10))))));
	}
	else if (s < 4.5) {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 11))))));
	}
	else if (s < 5.5) {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 10))))));
	}
	else if (s < 6.5) {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 4 : ((i < 3.5) ? 6 : ((i < 4.5) ? 7 : ((i < 5.5) ? 9 : 11))))));
	}
	else {
		r = ((i < 0.5) ? 0 : ((i < 1.5) ? 2 : ((i < 2.5) ? 3 : ((i < 3.5) ? 5 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : 11))))));
	}
	return r;
}

sdeg(s, idx) {
	o = floor(idx / 7);
	return scalenote(s, idx - 7 * o) + 12 * o;
}

edivs(i) {
	return ((i < 0.5) ? 0.25 : ((i < 1.5) ? 0.3333333 : ((i < 2.5) ? 0.5 : ((i < 3.5) ? 0.75 : ((i < 4.5) ? 0.6666667 : ((i < 5.5) ? 1 : ((i < 6.5) ? 1.5 : 2)))))));
}

// chord families used by the dice
fammin(i) {
	return ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 2 : ((i < 3.5) ? 3 : ((i < 4.5) ? 4 : ((i < 5.5) ? 5 : ((i < 6.5) ? 6 : ((i < 7.5) ? 7 : ((i < 8.5) ? 8 : ((i < 9.5) ? 9 : 15))))))))));
}

fammaj(i) {
	return ((i < 0.5) ? 10 : ((i < 1.5) ? 11 : ((i < 2.5) ? 12 : ((i < 3.5) ? 13 : ((i < 4.5) ? 7 : ((i < 5.5) ? 8 : ((i < 6.5) ? 6 : 15)))))));
}

famdark(i) {
	return ((i < 0.5) ? 0 : ((i < 1.5) ? 1 : ((i < 2.5) ? 2 : ((i < 3.5) ? 3 : ((i < 4.5) ? 4 : ((i < 5.5) ? 5 : ((i < 6.5) ? 6 : ((i < 7.5) ? 7 : ((i < 8.5) ? 8 : ((i < 9.5) ? 9 : ((i < 10.5) ? 14 : 15)))))))))));
