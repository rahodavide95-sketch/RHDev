{
  "git": { "deploymentEnabled": { "claude/*": false } },
  "regions": ["fra1"],
  "functions": {
    "api/price.js": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
